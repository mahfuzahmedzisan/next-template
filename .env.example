SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SITE_URL=

# --- Auth (BFF -> Laravel Passport, via mahfuz-ahmed-api) ---
# Base URL of the mahfuz-ahmed-api Laravel app (server-side only, never exposed to the browser).
# Passport's OAuth client id/secret are intentionally NOT configured here: the
# Laravel API's AuthController/PassportTokenService hold them server-side and
# exchange credentials for tokens internally, so this BFF never needs them.
LARAVEL_API_URL=http://127.0.0.1:8000
# 32+ byte secret used to derive the AES-256 key that encrypts the session cookie (JWE, dir/A256GCM).
# Generate with: openssl rand -base64 32
SESSION_SECRET=
