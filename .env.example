SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
NEXT_PUBLIC_SITE_URL=

# --- Auth (BFF -> Laravel Sanctum API tokens, via next-template-api) ---
# Base URL of the next-template-api Laravel app (server-side only, never exposed to the browser).
# Laravel returns a Sanctum personal access token on login; this BFF keeps it
# only inside the encrypted httpOnly session cookie.
LARAVEL_API_URL=http://127.0.0.1:8000
# Shared with the Laravel API (BFF_SECRET). Sent only from this server as
# X-BFF-Secret — never NEXT_PUBLIC_, so the browser Network tab never sees
# the API host or this secret. Generate with: openssl rand -base64 32
# Do not copy the production value onto Vercel preview deployments.
BFF_SECRET=
# 32+ byte secret used to derive the AES-256 key that encrypts the session cookie (JWE, dir/A256GCM).
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# --- Reverb (browser-safe). Must match REVERB_APP_KEY / HOST / PORT / SCHEME
# on next-template-api and next-template-reverb. Never put REVERB_APP_SECRET here.
NEXT_PUBLIC_REVERB_APP_KEY=
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http
