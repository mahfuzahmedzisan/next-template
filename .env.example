# --- Observability (optional) ---
# Leave empty to run without Sentry.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# --- SEO (required for correct canonical/OG URLs) ---
NEXT_PUBLIC_SITE_URL=
# Optional. Origin sent as X-Frontend-Origin on public SEO requests (sitemap,
# robots, page metadata). Must be listed in the API's FRONTEND_URLS. Defaults to
# NEXT_PUBLIC_SITE_URL. Canonical/OG URLs come from the SEO "Site URL" setting.
# SEO_PRIMARY_ORIGIN=https://example.com
# Distinctive token that must match SEO_SCANNER_UA_TOKEN on next-template-api
# (baked into its SEO_SCANNER_USER_AGENT). Lets the SEO health scanner's
# requests receive full <head> metadata from Next.js streaming. Changing it
# on one side without the other silently breaks SEO health scanning.
# SEO_SCANNER_UA_TOKEN=TemplateSeoScanner

# --- Security ---
# Contact published in /.well-known/security.txt (an email or mailto:/https: URL).
# Left empty, that file answers 404.
SECURITY_CONTACT=
# The CSP ships as Content-Security-Policy-Report-Only. Set to "enforce" once the
# browser console and Sentry show no real violations. Changing it needs a redeploy.
# CSP_MODE=enforce

# --- Auth (BFF -> Laravel Sanctum API tokens, via next-template-api) ---
# Base URL of the next-template-api Laravel app (server-side only, never exposed to the browser).
# Laravel returns a Sanctum personal access token on login; this BFF keeps it
# only inside the encrypted httpOnly session cookie.
LARAVEL_API_URL=http://127.0.0.1:8000
# Optional. Request timeout to Laravel in ms. Defaults to 10000 in production, 30000 otherwise.
# LARAVEL_API_TIMEOUT_MS=10000
# Shared with the Laravel API (BFF_SECRET). Sent only from this server as
# X-BFF-Secret — never NEXT_PUBLIC_, so the browser Network tab never sees
# the API host or this secret. Generate with: openssl rand -base64 32
# Do not copy the production value onto Vercel preview deployments.
BFF_SECRET=
# 32+ byte secret used to derive the AES-256 key that encrypts the session cookie (JWE, dir/A256GCM).
# Generate with: openssl rand -base64 32
SESSION_SECRET=

# --- Optional modules ---
# Unset = enabled. Set to "false" to hide a module's admin screens here, and
# disable the matching block in modules.php on the API to stop its
# routes/queues/scheduled jobs too. Keep both sides in sync.
# NEXT_PUBLIC_MODULE_MEDIA=false
# NEXT_PUBLIC_MODULE_BACKUPS=false
# NEXT_PUBLIC_MODULE_SEO_HEALTH=false
# NEXT_PUBLIC_MODULE_AUDIT=false
# NEXT_PUBLIC_MODULE_REALTIME=false

# --- Reverb (browser-safe). Must match REVERB_APP_KEY / HOST / PORT / SCHEME
# on next-template-api and next-template-reverb. Never put REVERB_APP_SECRET here.
NEXT_PUBLIC_REVERB_APP_KEY=
NEXT_PUBLIC_REVERB_HOST=localhost
NEXT_PUBLIC_REVERB_PORT=8080
NEXT_PUBLIC_REVERB_SCHEME=http
